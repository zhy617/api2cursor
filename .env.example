PROXY_TARGET_URL=https://your-relay-station.com
PROXY_API_KEY=sk-xxx
PROXY_PORT=3029
API_TIMEOUT=300
ACCESS_API_KEY=your-access-key
DEBUG=false
ENABLE_TUNNEL=true
TUNNEL_PROVIDER=cpolar

# ngrok
NGROK_COMMAND=ngrok
NGROK_API_URL=http://127.0.0.1:4040/api

# cpolar（国内可直连，推荐）
CPOLAR_COMMAND=cpolar
CPOLAR_REGION=
CPOLAR_API_URL=http://127.0.0.1:4040/api

# NATAPP（本地端口通常在 NATAPP 控制台的隧道配置中设置）
NATAPP_COMMAND=natapp
NATAPP_AUTHTOKEN=
NATAPP_CONFIG=
NATAPP_PUBLIC_URL=

# 自定义隧道命令，支持 {host} / {port} / {target_url} 占位符
CUSTOM_TUNNEL_COMMAND=
CUSTOM_TUNNEL_PUBLIC_URL=
CUSTOM_TUNNEL_URL_PATTERN=

TUNNEL_STARTUP_TIMEOUT=15
